# Copy this file to `passwords.yaml` (which is git-ignored) and replace every
# value with a long random string, e.g. the output of:
#
#   openssl rand -base64 32
#
# Only `development` and `test` are needed to run the app and its tests
# locally. Add `staging` / `production` sections with their own, different
# secrets when you deploy.

shared:

development:
  database: 'replace-me'
  redis: 'replace-me'
  serviceSecret: 'replace-me'
  emailSecretHashPepper: 'replace-me'
  jwtHmacSha512PrivateKey: 'replace-me'
  jwtRefreshTokenHashPepper: 'replace-me'

test:
  database: 'replace-me'
  redis: 'replace-me'
  emailSecretHashPepper: 'replace-me'
  jwtHmacSha512PrivateKey: 'replace-me'
  jwtRefreshTokenHashPepper: 'replace-me'
